{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sample",
  "description": "<out>/<machine>__<dishes>__<roster>__s<seed>.json (plans/2026-11-02-sample-schema.md), rewritten after every stage (code/sampler/scripts/bench.py, code/sampler/sample.py): exactly four blocks. metadata: the roster, the ledger, the maker summary, provenance (the _work record paths and the gate, certify and score figures) and media (the two stills). initial and goal: {dish: world pose} for every dish of the roster in the machine frame (metres, Z up, XYZW) plus the rack joints; initial keeps the counter, goal the Isaac-built poses, per dish its rack, slot, variant and commanded rack-local pose, and the score. dag: the certified graph's edges, each dish's layer and the order the goal was built in. Poses are stored, never re-derived from the seed. A block is null until its stage ran. The algorithms' results are in <out>/runs/<sample>.json (schema/run.json), the folder's samples in <out>/index.jsonl.",
  "type": "object",
  "required": ["metadata", "initial", "goal", "dag"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schema_version", "sample_id", "machine", "dishes", "seed", "variant", "params", "stages", "maker", "provenance", "media"],
      "properties": {
        "schema_version": {"type": "integer", "enum": [2]},
        "sample_id": {"type": "string"},
        "machine": {"type": "string"},
        "dishes": {"type": "string"},
        "seed": {"type": "integer"},
        "variant": {"type": ["string", "null"]},
        "params": {
          "type": "object",
          "required": ["kinds", "count", "on_counter", "counter_allowance"],
          "properties": {
            "difficulty": {"type": ["string", "null"], "enum": ["easy", "medium", "hard", null]},
            "kinds": {"type": "array", "items": {"type": "string"}},
            "count": {"type": "object"},
            "on_counter": {"type": ["integer", "null"]},
            "counter_allowance": {"type": "integer"},
            "levels": {"type": "object"}
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "params", "code_sha", "utc", "result"],
            "properties": {
              "stage": {"type": "string", "enum": ["load", "initial", "gate_initial", "fit", "build", "gate_goal", "certify", "score", "graph", "stills", "run", "video", "report"]},
              "params": {"type": "object"},
              "code_sha": {"type": ["string", "null"]},
              "utc": {"type": "string"},
              "result": {"type": "string", "enum": ["PASS", "FAIL", "SKIP"]},
              "note": {"type": ["string", "null"]}
            }
          }
        },
        "maker": {
          "type": ["object", "null"],
          "properties": {
            "method": {"type": ["string", "null"]},
            "level": {"type": ["integer", "null"]},
            "S_first_fit": {"type": ["number", "null"]},
            "S_ascent": {"type": ["number", "null"]},
            "sweeps": {"type": ["integer", "null"]}
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "load": {"type": "object"},
            "initial_record": {"type": "string"},
            "settle": {"type": ["object", "null"]},
            "gate_initial": {"type": ["object", "null"]},
            "load_id": {"type": "string"},
            "goal_record": {"type": "string"},
            "gate_goal": {"type": ["object", "null"]},
            "certify": {"type": ["object", "null"]},
            "score": {"type": ["object", "null"]}
          }
        },
        "media": {
          "type": ["object", "null"],
          "properties": {"initial": {"type": "string"}, "goal": {"type": "string"}}
        }
      }
    },
    "initial": {
      "type": ["object", "null"],
      "required": ["poses", "rack_joints", "counter"],
      "properties": {
        "poses": {"type": "object"},
        "rack_joints": {"type": "object"},
        "counter": {
          "type": "object",
          "required": ["size_m", "center_m", "top_z_m", "start_count", "cap", "stacks"],
          "properties": {"stacks": {"type": "array"}}
        }
      }
    },
    "goal": {
      "type": ["object", "null"],
      "required": ["poses", "rack_joints", "slots", "score"],
      "properties": {
        "poses": {"type": "object"},
        "rack_joints": {"type": "object"},
        "slots": {"type": "object"},
        "score": {
          "type": ["object", "null"],
          "required": ["S_ref", "S_area", "per_dish"],
          "properties": {"S_ref": {"type": "number"}, "S_area": {"type": "number"}, "per_dish": {"type": "array"}}
        }
      }
    },
    "dag": {
      "type": ["object", "null"],
      "required": ["nodes", "edges", "layers", "order"],
      "properties": {
        "nodes": {"type": "array", "items": {"type": "string"}},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["a", "b", "kind"],
            "properties": {"a": {"type": "string"}, "b": {"type": "string"}, "kind": {"type": "string", "enum": ["support", "access"]}}
          }
        },
        "layers": {"type": "object"},
        "order": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
