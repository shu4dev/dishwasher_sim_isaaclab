# Downloaded assets — never commit (see README for sources + licenses).
# Includes derived USDs and the collision-world cache (assets/cache/), all regenerable.
# No trailing slash: on the corallab machine these are SYMLINKS onto the 2 TB drive, and
# `name/` patterns match only real directories.
/assets

# Visual-evidence media and planning results stay on disk for review; only curated
# copies under docs/figures/ are tracked.
/media
/results

# Logs and outputs
/logs
/outputs
wandb/

# build/ is a SYMLINK onto the 2 TB drive since 2026-09-17 (holds the Frigidaire
# collection); `build/` below matches only a real directory, so ignore the link too.
/build

# experiments/ is a local symlink index over the ignored data roots.
/experiments

# root-level convenience symlink to the pose viewer
/index.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Editors / misc
.vscode/
.idea/
*.swp
.DS_Store

# caches / agent state
.ruff_cache/
.mypy_cache/
.claude/
env*/
